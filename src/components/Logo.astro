---
interface Props {
  size?: number;
}
const { size = 32 } = Astro.props;
---
<span class="logo">
  <svg width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
    <rect width="64" height="64" rx="14" fill="currentColor" />
    <path d="M10 40c6 0 6-6 12-6s6 6 12 6 6-6 12-6 6 6 8 6" fill="none" stroke="#e8582c" stroke-width="5" stroke-linecap="round" />
    <path d="M10 26c6 0 6-6 12-6s6 6 12 6 6-6 12-6 6 6 8 6" fill="none" stroke="#f3eee4" stroke-width="3" stroke-linecap="round" opacity=".7" />
  </svg>
  <span class="logo-word">AUTO<span>SITE</span></span>
</span>
