---
import { href } from '../lib/site';
import '../styles/master-integration.css';
import '../styles/motion.css';
import '../styles/bold-surf.css';
import '../master/ks-design.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  bodyClass?: string;
}
const { title, description, noindex = false, bodyClass } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <meta name="theme-color" content="#0e2233" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary" />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
    <script>
      import { initKSDesign } from '../master/ks-motion.js';
      import '../scripts/share.js';
      initKSDesign(document);
    </script>
  </body>
</html>
