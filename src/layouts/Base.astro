---
const { title, description } = Astro.props;
import '../styles/global.css';
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} />
<meta name="theme-color" content="#082d3a" />
<title>{title}</title>
</head>
<body>
<slot />
</body>
</html>
